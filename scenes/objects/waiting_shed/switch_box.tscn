[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/interactions/openable_container.gd" id="1_container"]
[ext_resource type="Script" path="res://scripts/environment/procedural_prop.gd" id="2_prop"]

[sub_resource type="BoxShape3D" id="BoxShape3D_area"]
size = Vector3(0.36, 0.14, 0.26)

; A small hinged wooden box that opens with a plain interaction. What lies inside is added to `Contents` by the scene that places the box
; (the waiting shed puts the videotape and the telephone token there); `Contents` stays out of the tree until the lid is lifted.
[node name="SwitchBox" type="Node3D"]
script = ExtResource("1_container")
prompt_text = "PROMPT_OPEN"
persistent_id = &"junction_switch_box"

[node name="Model" type="Node3D" parent="."]
script = ExtResource("2_prop")
kind = &"switch_box"

[node name="Contents" type="Node3D" parent="."]

[node name="InteractArea" type="Area3D" parent="."]

[node name="CollisionShape3D" type="CollisionShape3D" parent="InteractArea"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, -0.01, 0)
shape = SubResource("BoxShape3D_area")
