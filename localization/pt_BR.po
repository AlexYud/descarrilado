msgid "CAPTION_REC_01"
msgstr "Você não precisa me esperar."

msgid "CAPTION_REC_02"
msgstr "Claro que preciso."

msgid "CAPTION_REC_03"
msgstr "Juli, eu disse que você não precisa."

msgid "CAPTION_REC_04"
msgstr "Eu sei. É por isso que eu quero."

msgid "CAPTION_REC_05"
msgstr "Você sempre torna impossível ficar brava com você."

msgid "CAPTION_REC_06"
msgstr "Ótimo."

msgid "CAPTION_REC_07"
msgstr "Isso nem sempre é uma coisa boa."

