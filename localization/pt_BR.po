msgid "AD_OURS"
msgstr "NOSSA?"

msgid "ITEM_BUS_TICKET_SOPHIA_NAME"
msgstr "Passagem de Ônibus da Sophia"

msgid "ITEM_BUS_TICKET_SOPHIA_DESCRIPTION"
msgstr "Uma passagem só de ida para São Paulo. Sophia escreveu o nome nela."

msgid "ITEM_BUS_TICKET_UNCLAIMED_NAME"
msgstr "Passagem de Ônibus Sem Dono"

msgid "ITEM_BUS_TICKET_UNCLAIMED_DESCRIPTION"
msgstr "Duas passagens para a mesma partida. Sophia pegou uma e deixou a outra para alguém escolher."

msgid "BUS_TICKET_PRINT"
msgstr "PASSAGEM DE ÔNIBUS\nVila ferroviária / São Paulo\nSó ida"

msgid "BUS_TICKET_PASSENGER"
msgstr "Passageiro:"

msgid "BUS_TICKET_NAME_SOPHIA"
msgstr "Sophia"

msgid "BUS_TICKET_IF_YOU_WANT"
